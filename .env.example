# AIIC committee orchestrator — environment template.
#
#   cp .env.example .env    then fill in the REQUIRED values below.
#
# Variable names are fixed by backend/app/config.py::Settings (CONTRACTS.md
# §3.5). Adding one means adding it there AND here. Never read os.environ
# directly for config — go through get_settings().
#
# EVERY VALUE HERE IS EMPTY ON PURPOSE. This file previously shipped a
# real-looking default for the Postgres password (and a placeholder JWT
# secret) — security review SEC-08. An operator who copied it verbatim got a
# well-known database password. A template must never contain a usable secret,
# and the secret scanner is configured to fail if one reappears here.
#
# AFTER EDITING .env YOU MUST RECREATE THE CONTAINER:
#     docker compose up -d --force-recreate backend
# A plain `docker compose restart` reuses the environment baked in at container
# creation and your change will appear to have no effect. Handoff §9.3 records
# that this cost two full sessions.


# =============================================================================
# REQUIRED — the stack does not work without these
# =============================================================================

# Every agent call in the committee. Get one at https://console.anthropic.com
# (Settings -> API keys). There is deliberately NO provider fallback
# (CONTRACTS.md §4.3), so if this is wrong or unfunded, nothing runs.
ANTHROPIC_API_KEY=

# Database password. REQUIRED — docker-compose.yml uses
# ${POSTGRES_PASSWORD:?...} and refuses to start without it. Generate one:
#     openssl rand -base64 24
#
# WARNING (CONTRACTS.md §4.5): this value is baked into the Postgres data
# directory when the volume is FIRST initialised. On an existing volume,
# changing it here does not rotate anything — Postgres will simply reject the
# new password and the backend will fail to connect. Rotating for real means
# `ALTER USER committee WITH PASSWORD '...'` inside the running database AND
# updating this file, in that order.
POSTGRES_PASSWORD=


# =============================================================================
# REQUIRED FOR SPECIFIC CAPABILITIES — the stack starts without them, but the
# feature they gate returns nothing
# =============================================================================

# Embeddings (text-embedding-3-small) for the pgvector corpus. This is NO
# LONGER dormant: `semantic_search_notes` is registered and appears in every
# agent's tool list, so an empty or unfunded key now degrades live retrieval
# rather than an unused code path. An empty OpenAI balance previously caused
# cascade failures. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Notion is the institutional memory. Without these, `search_notes`,
# `read_note`, the pgvector sync and the report writeback all return nothing.
# Create an internal integration at https://www.notion.so/my-integrations,
# then SHARE each database with it (the integration sees nothing otherwise).
NOTION_API_KEY=
# Database IDs: open the database as a full page, copy the 32-hex-character
# segment out of the URL.
NOTION_TRANSCRIPTS_DB=
NOTION_LEARNINGS_DB=
NOTION_PROJECTS_DB=

# The `web_search` tool. Free tier is enough for development.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=


# =============================================================================
# OPTIONAL
# =============================================================================

# CoinGecko demo key. Works without one, but the unkeyed tier rate-limits hard
# and 429 storms make the data agents stall and report thin data. Demo tier is
# 30 req/min. https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# The `search_twitter` tool. Without it that tool returns no results.
# https://developer.x.com  (read `getattr(settings, "x_bearer_token", "")`)
X_BEARER_TOKEN=

# Telegram companion (telegram_bot.py). Not part of the compose stack.
# Token from @BotFather; the chat id restricts who the bot will answer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
COMMITTEE_API_BASE=http://localhost:8100
COMMITTEE_REPORT_BASE=http://localhost:8100

# CORS allow-list origin. Read by app/main.py.
FRONTEND_URL=http://localhost:3100

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# =============================================================================
# LOCAL DEVELOPMENT ONLY — never set these on the VPS
# =============================================================================
# Defaults reproduce production exactly, so leaving them unset is correct
# everywhere except a machine running several stacks at once (or one that
# already has Postgres on 5432). Setting them removes the need for a private
# docker-compose.override.yml.
#
# CONTAINER_PREFIX=aiic-mybranch          # default: committee
# POSTGRES_HOST_PORT=55436                # default: 5432
# REDIS_HOST_PORT=56383                   # default: 6379
# BACKEND_HOST_PORT=58104                 # default: 8100
#
# Host interface the published ports bind to. Postgres and Redis default to
# 127.0.0.1 and should stay there (security review SEC-02). On the VPS,
# consider narrowing the API to the Tailscale address instead of 0.0.0.0:
# BACKEND_BIND_ADDR=100.95.239.105        # default: 0.0.0.0


# =============================================================================
# SET BY docker-compose.yml — do NOT put these in .env
# =============================================================================
# DATABASE_URL   composed from POSTGRES_PASSWORD; setting it here is ignored
#                for the container and will only confuse you.
# REDIS_URL      redis://redis:6379/0 on the compose network.


# =============================================================================
# DECLARED IN config.py BUT READ BY NO CODE — do not treat these as features
# =============================================================================
# CONTRACTS.md §3.6 is explicit that Etherscan, Dune, GitHub, Snapshot, Tally,
# Safe and Token Terminal tools are NOT BUILT. The eleven live tools are
# get_price, get_token_info, get_tvl, get_protocol_fees, get_klines,
# get_orderbook_depth, compute_technical_levels, web_search, search_twitter,
# search_notes, read_note — plus semantic_search_notes.
#
# Verified 24 Aug 2026 by grepping every `settings.<name>` read:
#
#   ETHERSCAN_API_KEY     0 reads — no Etherscan tool exists
#   DUNE_API_KEY          0 reads — no Dune tool exists
#   GITHUB_TOKEN          0 reads — no GitHub tool exists
#   GOOGLE_CLIENT_ID      0 reads — there is no OAuth flow
#   GOOGLE_CLIENT_SECRET  0 reads — there is no OAuth flow
#   JWT_SECRET            0 reads — there is no auth layer at all; no endpoint
#                         is authenticated (security review SEC-03), and
#                         python-jose has been removed from requirements.txt
#   BACKEND_URL           0 reads
#
# WHISPER_MODEL was previously listed here and is not even declared in
# Settings — there is no transcription pipeline. Removed.
#
# Setting any of the above does nothing. They are listed so that the next
# person does not spend an afternoon looking for the feature.
